# ═══════════════════════════════════════════════════════════════════
# GENE1799 UNIFIED PLATFORM - ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost
BASE_URL=http://localhost:3000

# Database
DB_TYPE=sqlite
DB_PATH=./database/gene1799.db
MONGODB_URI=mongodb://localhost:27017/gene1799
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_USE_LONG_RANDOM_STRING
JWT_EXPIRATION=7d
SESSION_SECRET=CHANGE_THIS_SESSION_SECRET_TOO
BCRYPT_ROUNDS=10
ENCRYPTION_KEY=

# ═══════════════════════════════════════════════════════════════════
# AI SERVICES
# ═══════════════════════════════════════════════════════════════════

# OpenAI
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# Google AI
GOOGLE_AI_KEY=
GOOGLE_MODEL=gemini-pro

# Perplexity
PERPLEXITY_API_KEY=

# Replicate
REPLICATE_API_TOKEN=

# Stability AI (Stable Diffusion)
STABILITY_API_KEY=
STABILITY_ENGINE=stable-diffusion-xl-1024-v1-0

# Ollama (Local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ═══════════════════════════════════════════════════════════════════
# BLOCKCHAIN & WEB3
# ═══════════════════════════════════════════════════════════════════

# Ethereum
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
ETHEREUM_TESTNET_RPC=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
ETHEREUM_CHAIN_ID=1

# Infura
INFURA_PROJECT_ID=
INFURA_PROJECT_SECRET=

# Alchemy
ALCHEMY_API_KEY=
ALCHEMY_NETWORK=eth-mainnet

# Wallet
WALLET_PRIVATE_KEY=
WALLET_ADDRESS=
WALLET_MNEMONIC=

# Polygon
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_PROJECT_ID
POLYGON_CHAIN_ID=137

# ═══════════════════════════════════════════════════════════════════
# NFT MARKETPLACES
# ═══════════════════════════════════════════════════════════════════

# Zora
ZORA_API_KEY=
ZORA_NETWORK=mainnet

# OpenSea
OPENSEA_API_KEY=
OPENSEA_NETWORK=mainnet

# SuperRare
SUPERRARE_API_KEY=
SUPERRARE_CONTRACT_ADDRESS=

# Rarible
RARIBLE_API_KEY=

# Foundation
FOUNDATION_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# IPFS & STORAGE
# ═══════════════════════════════════════════════════════════════════

# Pinata (IPFS)
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_JWT=

# IPFS Node
IPFS_HOST=localhost
IPFS_PORT=5001
IPFS_PROTOCOL=http

# Arweave
ARWEAVE_WALLET_KEY=

# ═══════════════════════════════════════════════════════════════════
# CRYPTO EXCHANGES
# ═══════════════════════════════════════════════════════════════════

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# Coinbase
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Kraken
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ═══════════════════════════════════════════════════════════════════
# MESSAGING & NOTIFICATIONS
# ═══════════════════════════════════════════════════════════════════

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@gene1799.com

# ═══════════════════════════════════════════════════════════════════
# SOCIAL MEDIA
# ═══════════════════════════════════════════════════════════════════

# Twitter/X
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# Instagram
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ═══════════════════════════════════════════════════════════════════
# ANALYTICS & MONITORING
# ═══════════════════════════════════════════════════════════════════

# Google Analytics
GA_TRACKING_ID=

# Sentry (Error Tracking)
SENTRY_DSN=

# LogRocket
LOGROCKET_APP_ID=

# ═══════════════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ═══════════════════════════════════════════════════════════════════

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_MESSAGE=Too many requests, please try again later

# CORS
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# File Upload
MAX_FILE_SIZE=100mb
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,audio/mp3

# Cache
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/gene1799.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7

# Sessions
SESSION_LIFETIME=86400000
SESSION_COOKIE_NAME=gene1799_session

# ═══════════════════════════════════════════════════════════════════
# FEATURES FLAGS
# ═══════════════════════════════════════════════════════════════════

FEATURE_AI_MUSIC=true
FEATURE_AI_VIDEO=true
FEATURE_AI_IMAGE=true
FEATURE_CRYPTO_TRADING=true
FEATURE_NFT_MINTING=true
FEATURE_BLOCKCHAIN=true
FEATURE_SOCIAL_INTEGRATION=true
FEATURE_TELEGRAM_BOT=true
FEATURE_AUTO_LEARNING=true

# ═══════════════════════════════════════════════════════════════════
# DEVELOPMENT
# ═══════════════════════════════════════════════════════════════════

DEBUG=false
VERBOSE_LOGGING=false
ENABLE_PROFILER=false
MOCK_AI_RESPONSES=false
