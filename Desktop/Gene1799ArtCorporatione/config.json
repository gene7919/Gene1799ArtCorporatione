{
  "app": {
    "version": "2.0 Pro",
    "name": "Gene1799 Advanced AI Platform",
    "theme": "green_neon",
    "language": "it"
  },
  
  "auth": {
    "max_login_attempts": 5,
    "session_timeout_minutes": 120,
    "password_min_length": 6,
    "encryption": "sha256"
  },
  
  "api_services": {
    "openai": {
      "endpoint": "https://api.openai.com/v1",
      "models": ["gpt-4", "gpt-3.5-turbo"],
      "key_placeholder": "sk-..."
    },
    "dalle": {
      "endpoint": "https://api.openai.com/v1/images",
      "models": ["dall-e-3"],
      "key_placeholder": "key-..."
    },
    "stability_ai": {
      "endpoint": "https://api.stability.ai",
      "models": ["sd-3", "sd-turbo"],
      "key_placeholder": "key-..."
    },
    "runwayml": {
      "endpoint": "https://api.runwayml.com",
      "models": ["gen-2", "gen-3"],
      "key_placeholder": "key-..."
    },
    "render": {
      "endpoint": "https://gene1799-api.onrender.com",
      "type": "backend",
      "key_placeholder": "key-..."
    }
  },
  
  "agents": {
    "default_agents": [
      {
        "id": "anti-cancer",
        "name": "Anti-Cancer AI Engine",
        "specialization": "Medical",
        "type": "Text",
        "model": "gpt-4",
        "status": "active"
      },
      {
        "id": "drug-discovery",
        "name": "Drug Discovery Engine",
        "specialization": "Pharma",
        "type": "Text",
        "model": "gpt-4",
        "status": "active"
      },
      {
        "id": "ml-orchestrator",
        "name": "ML Orchestrator",
        "specialization": "DataScience",
        "type": "Hybrid",
        "model": "gpt-4",
        "status": "active"
      }
    ],
    "agent_types": ["Text", "Image", "Music", "Video", "Hybrid"],
    "specializations": [
      "Medical",
      "Pharmaceutical",
      "Data Science",
      "Healthcare",
      "Content",
      "Social Media",
      "Custom"
    ]
  },
  
  "content_creation": {
    "text": {
      "engine": "openai",
      "model": "gpt-4",
      "max_tokens": 2000,
      "temperature": 0.7
    },
    "image": {
      "engine": "dalle",
      "model": "dall-e-3",
      "quality": "hd",
      "size": "1024x1024"
    },
    "music": {
      "engine": "runway",
      "duration_seconds": 180,
      "quality": "high"
    },
    "video": {
      "engine": "runway",
      "duration_seconds": 15,
      "resolution": "1080p",
      "format": "mp4"
    }
  },
  
  "social_media": {
    "platforms": [
      {
        "name": "Twitter",
        "max_chars": 280,
        "supports": ["text", "image", "video"],
        "api_version": "v2"
      },
      {
        "name": "LinkedIn",
        "max_chars": 3000,
        "supports": ["text", "image", "video"],
        "api_version": "v2"
      },
      {
        "name": "Instagram",
        "max_chars": 2200,
        "supports": ["image", "video"],
        "api_version": "v2"
      },
      {
        "name": "TikTok",
        "max_seconds": 600,
        "supports": ["video"],
        "api_version": "v2"
      },
      {
        "name": "Telegram",
        "supports": ["text", "image", "video"],
        "type": "bot"
      }
    ],
    "auto_formatting": true,
    "smart_hashtags": true,
    "scheduling": true
  },
  
  "telegram_bot": {
    "enabled": false,
    "token_placeholder": "your_bot_token_here",
    "commands": [
      "/start",
      "/ask",
      "/create",
      "/post",
      "/agents",
      "/status",
      "/help"
    ],
    "webhook": "https://gene1799-api.onrender.com/telegram"
  },
  
  "storage": {
    "max_chats": 10000,
    "max_agents": 100,
    "max_content_items": 5000,
    "auto_backup": true,
    "backup_interval_hours": 24
  },
  
  "ui_theme": {
    "name": "Green Neon",
    "primary_color": "#00ff41",
    "secondary_color": "#39ff14",
    "accent_color": "#00ffff",
    "background": "#0a0e27",
    "dark_background": "#050a1a",
    "warning_color": "#ffaa00",
    "font_family": "Arial",
    "font_size_base": 10
  },
  
  "server": {
    "render_endpoint": "https://gene1799-api.onrender.com",
    "timeout_seconds": 30,
    "retry_attempts": 3,
    "health_check_interval": 60
  },
  
  "logging": {
    "enabled": true,
    "level": "INFO",
    "file": "logs/gene1799.log",
    "max_size_mb": 100,
    "backup_count": 5
  }
}
