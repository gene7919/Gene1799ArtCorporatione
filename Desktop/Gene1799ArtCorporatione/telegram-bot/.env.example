# GENE1799 Telegram Bot Configuration
# Copy this file to .env and fill in your values

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Telegram Channel ID (@getidsbot to find)
CHANNEL_ID=-100XXXXXXXXX

# Admin User IDs (comma-separated, no spaces)
ADMIN_IDS=123456789,987654321

# Base Network RPC URL
BASE_RPC_URL=https://mainnet.base.org

# GENE1799 Token Contract Address
TOKEN_CONTRACT=0x63800f788e788e0d3a9cc0ce92a8e6c866f0f0f0

# Optional: Superrare API Token
SUPERRARE_TOKEN=optional_token

# Optional: OpenSea API Key
OPENSEA_KEY=optional_key

# Environment
NODE_ENV=production

# Bot Timezone (Europe/Rome)
BOT_TIMEZONE=Europe/Rome
