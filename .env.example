# GENE1799 ART CORPORATIONE - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ============================================================================
# SECURITY
# ============================================================================
JWT_SECRET=your_jwt_secret_here_change_in_production
SESSION_SECRET=your_session_secret_here_change_in_production
CORS_ORIGIN=*
RATE_LIMIT_MAX=100

# ============================================================================
# AI SERVICES API KEYS
# ============================================================================
# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key

# Stability AI
STABILITY_API_KEY=your-stability-ai-key

# RunwayML
RUNWAYML_API_KEY=your-runwayml-key

# Azure OpenAI (optional)
AZURE_OPENAI_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# ============================================================================
# BLOCKCHAIN & WEB3
# ============================================================================
# Ethereum/Base Network
ETHEREUM_RPC_URL=https://mainnet.base.org
ETHEREUM_NETWORK=base
TOKEN_CONTRACT_ADDRESS=0x63800f788e788e0d3a9cc0ce92a8e6c866f0f0f0
CHAIN_ID=8453

# Private Key (for automated transactions - NEVER commit this!)
ETHEREUM_PRIVATE_KEY=

# NFT Platform APIs
OPENSEA_API_KEY=your-opensea-api-key
ZORA_API_KEY=your-zora-api-key
SUPERRARE_API_KEY=your-superrare-api-key

# ============================================================================
# SOCIAL MEDIA INTEGRATIONS
# ============================================================================
# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx
TELEGRAM_ADMIN_ID=your-telegram-user-id

# Twitter/X API
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# LinkedIn API
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

# Instagram (via Facebook Graph API)
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-account-id

# TikTok API
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/gene1799
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gene1799
DB_USER=gene1799_user
DB_PASSWORD=your_secure_password

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# CLOUD STORAGE
# ============================================================================
# Azure Storage
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_KEY=your-storage-key
AZURE_STORAGE_CONTAINER=gene1799-content

# AWS S3 (alternative)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=gene1799-content
AWS_REGION=eu-central-1

# ============================================================================
# MONITORING & ANALYTICS
# ============================================================================
# Azure Application Insights
AZURE_INSIGHTS_KEY=your-insights-key

# Sentry Error Tracking
SENTRY_DSN=your-sentry-dsn

# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# ============================================================================
# DEPLOYMENT SERVICES
# ============================================================================
# Render.com
RENDER_API_KEY=your-render-api-key
RENDER_SERVICE_ID=your-service-id

# Azure
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=gene1799-rg
AZURE_APP_SERVICE=gene1799-app

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_AI_AGENTS=true
ENABLE_CONTENT_CREATION=true
ENABLE_SOCIAL_AUTOMATION=true
ENABLE_WEB3=true
ENABLE_TELEGRAM_BOT=true
ENABLE_AUTO_HEALING=true
ENABLE_LEARNING_ENGINE=true

# ============================================================================
# ADVANCED CONFIGURATION
# ============================================================================
# Content Generation Settings
CONTENT_MAX_TOKENS=2000
CONTENT_TEMPERATURE=0.7
VIDEO_DURATION_SECONDS=15
MUSIC_DURATION_SECONDS=180

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_TIMEOUT_MINUTES=120
MAX_LOGIN_ATTEMPTS=5

# Logging
LOG_FILE_PATH=logs/gene1799.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=5

# Auto-backup
AUTO_BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24

# Health Check
HEALTH_CHECK_INTERVAL_SECONDS=60
HEALTH_CHECK_TIMEOUT_SECONDS=30

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================
DEBUG=false
MOCK_AI_RESPONSES=false
SKIP_AUTH=false
