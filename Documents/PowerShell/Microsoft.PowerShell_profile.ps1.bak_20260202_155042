# ========================================
# GENE1799 ART CORPORATIONE - AUTO LOADER
# ========================================

$ErrorActionPreference = 'Continue'

Write-Host "`n╔════════════════════════════════════╗" -ForegroundColor Cyan
Write-Host "║   GENE1799 ART CORPORATIONE HUB    ║" -ForegroundColor Cyan
Write-Host "╚════════════════════════════════════╝`n" -ForegroundColor Cyan

# Percorsi moduli canonical (D:\Gene1799\modules)
$Gene1799Root = 'D:\Gene1799'
$Gene1799Modules = Join-Path $Gene1799Root 'modules'

# Carica moduli in ordine (Core -> Extensions -> Bus)
$modulesToLoad = @(
  @{Name='Gene1799Core'; Path=Join-Path $Gene1799Modules 'Gene1799Core\Gene1799Core.psd1'},
  @{Name='Gene1799Extensions'; Path=Join-Path $Gene1799Modules 'Gene1799Extensions\Gene1799Extensions.psd1'},
  @{Name='Gene1799Bus'; Path=Join-Path $Gene1799Modules 'Gene1799Bus\Gene1799Bus.psm1'}
)

foreach($module in $modulesToLoad){
  if(Test-Path -LiteralPath $module.Path){
    try {
      Import-Module $module.Path -Force -ErrorAction Stop
      Write-Host "✓ $($module.Name) caricato" -ForegroundColor Green
    } catch {
      Write-Warning "Errore caricamento $($module.Name): $_"
    }
  } else {
    Write-Warning "$($module.Name) non trovato in: $($module.Path)"
  }
}

Write-Host "`n✓ HUB READY`n" -ForegroundColor Green

# Comandi disponibili
Write-Host "Comandi disponibili (principali):" -ForegroundColor Yellow
Write-Host "  gene1799          -> menu Gene1799 (se disponibile)" -ForegroundColor Gray
Write-Host "  Start-Gene1799Core -> avvia il core" -ForegroundColor Gray
Write-Host "  Get-Gene1799Status -> stato sistema" -ForegroundColor Gray
Write-Host "  Expand-SuperCore   -> espansione SuperCore" -ForegroundColor Gray
Write-Host "  Write-Gene1799Log  -> logging sistema`n" -ForegroundColor Gray

# Set default location a D:\Gene1799
Set-Location -Path $Gene1799Root -ErrorAction SilentlyContinue
